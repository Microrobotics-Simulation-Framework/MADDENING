# MADDENING Cloud Container
# GPU-enabled container with GStreamer for WebRTC streaming
#
# Incorporates all findings from RunPod cloud testing (2026-03-19/20):
#   - Uses the system python3 as primary — required for system python3-gi
#     bindings.  Ubuntu 24.04's python3 is 3.12: MADDENING requires Python
#     >= 3.11 and jax >= 0.10 requires >= 3.11 (0.11+: >= 3.12), so the
#     22.04 image (python3 = 3.10) can no longer install either.
#   - Installs jax[cuda12] with the pyproject range
#   - GStreamer plugins including -ugly (for x264enc)
#   - ZMQ for multi-job coordinator communication
#   - matplotlib for server-side frame rendering (Agg backend, headless)
#
# Build:
#   docker build -f docker/Dockerfile.cloud -t maddening-cloud:latest .
#
# Run (single job):
#   docker run --gpus all -p 8000:8000 -p 5555:5555 -p 5556:5556 \
#     -e MADDENING_CLOUD_CONFIG='{}' maddening-cloud:latest
#
# Run (multi-job coordinator):
#   docker run --gpus all -p 8000:8000 -p 5580:5580 -p 5555:5555 -p 5556:5556 \
#     -e IS_RANK0=1 -e COORDINATOR_PORT=5580 maddening-cloud:latest

FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

LABEL org.opencontainers.image.title="maddening-cloud" \
      org.opencontainers.image.description="MADDENING simulation server with GPU streaming" \
      org.opencontainers.image.source="https://github.com/Microrobotics-Simulation-Framework/MADDENING"

ENV DEBIAN_FRONTEND=noninteractive

# ── System dependencies ──────────────────────────────────────────────
# Python 3.12 (system default on Ubuntu 24.04) + pip
# GStreamer (all plugins including -ugly for x264enc)
# PyGObject bindings (python3-gi for system python3)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    # GStreamer core + plugins
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-nice \
    gstreamer1.0-tools \
    # GStreamer GIR bindings (for PyGObject)
    gir1.2-gst-plugins-bad-1.0 \
    gir1.2-gstreamer-1.0 \
    # PyGObject (must be system python3 version for gi._gi C extension)
    python3-gi \
    python3-gi-cairo \
    libgirepository1.0-dev \
    # Utilities
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ─────────────────────────────────────────────
# Install MADDENING with server + streaming extras
# Uses system python3 (3.12) which has the gi bindings; pip installs into
# the system interpreter on purpose (PEP 668 needs --break-system-packages)
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ src/

# Install JAX with CUDA 12 support (same range as pyproject's `cuda12`
# extra) + MADDENING[server]
RUN pip3 install --no-cache-dir --break-system-packages \
    "jax[cuda12]>=0.10,<0.13" && \
    pip3 install --no-cache-dir --break-system-packages \
    -e ".[server]" && \
    pip3 install --no-cache-dir --break-system-packages \
    websockets

# ── Verify installation ─────────────────────────────────────────────
RUN python3 -c "import jax; print(f'JAX: {jax.__version__}')" && \
    python3 -c "from maddening import GraphManager; print('MADDENING: OK')" && \
    python3 -c "import gi; gi.require_version('Gst', '1.0'); from gi.repository import Gst; print(f'GStreamer: {Gst.version_string()}')" && \
    python3 -c "import zmq; print(f'ZMQ: {zmq.zmq_version()}')"

# ── Ports ────────────────────────────────────────────────────────────
#   8000  — FastAPI HTTP/WS server
#   8443  — Selkies signaling / WebRTC
#   5555  — ZMQ state PUB
#   5556  — ZMQ command SUB
#   5580  — Multi-job coordinator (ROUTER socket)
#
#   SECURITY: this image binds MADDENING_HOST=0.0.0.0, which is not
#   loopback, so port 8000 requires "Authorization: Bearer <token>" on
#   every route but /healthz and /viz/*.  Set MADDENING_API_TOKEN, or
#   read the token the server generates and logs once at start-up; if
#   nothing reads this container's log, set MADDENING_API_TOKEN or point
#   MADDENING_API_TOKEN_FILE at a mounted volume.  A blank
#   MADDENING_API_TOKEN makes the server refuse to start.
#
#   There is still NO TLS, so the token and every state snapshot cross
#   the network in cleartext.  Prefer publishing 8000 to loopback only
#   (docker run -p 127.0.0.1:8000:8000) and reaching it over an SSH
#   tunnel, or front it with a TLS-terminating proxy.  Port 8443
#   (signaling) authenticates clients with HMAC tokens, but only once
#   MADDENING_STREAM_SECRET is set -- without it no client can connect
#   at all.
#
#   The ZMQ ports (5555 state, 5556 commands, 5580 coordinator) are
#   listed above because the image CAN serve them, not because anything
#   binds them by default.  Since v0.4.0 those sockets default to a
#   loopback bind, so a process inside this container that takes the
#   defaults is unreachable through a published port -- deliberately.
#   To serve them off-box, bind a non-loopback address: that turns on
#   ZMQ CURVE encryption and requires the same MADDENING_API_TOKEN on
#   the client.  There are no key files to distribute; both CURVE
#   keypairs are derived from that one token.
#
#   5556 in particular is an actuation path -- CommandReceiver's payload
#   reaches GraphManager.step(external_inputs=...) unchecked -- so
#   publish it only deliberately.  Before v0.4.0 all three bound every
#   interface with no authentication at all; see MADD-ANO-015.
EXPOSE 8000 8443 5555 5556 5580

# ── Entrypoint ───────────────────────────────────────────────────────
# The server must bind 0.0.0.0 to be reachable through a published port
# at all; that is why it warns at startup instead of refusing.  What
# keeps the API private is the address you publish the port on, and the
# firewall in front of it.
ENV MADDENING_HOST=0.0.0.0
ENV MADDENING_PORT=8000
CMD ["python3", "-m", "maddening.cloud.entrypoint"]
